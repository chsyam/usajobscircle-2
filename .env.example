# Public site URL used for metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the future REST API (backed by MySQL).
# Leave empty to use the local mock data in /data.
NEXT_PUBLIC_API_URL=

# Server-only database settings for the future backend (never commit real values)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
